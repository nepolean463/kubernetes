version: 2
ethernets:
  lan0:
    match:
      macaddress: "${mac_address}"
    dhcp4: false
    dhcp6: false
    addresses:
      - ${ip_cidr}
    routes:
      - to: default
        via: ${gateway}
    nameservers:
      addresses:
%{ for dns in dns_servers ~}
        - ${dns}
%{ endfor ~}

  internal0:
    match:
      macaddress: "${internal_mac_address}"
    dhcp4: false
    dhcp6: false
    addresses:
      - ${internal_ip_cidr}

[control_plane]
k8s-cp-1 ansible_host=192.168.1.210

[workers]
k8s-worker-1 ansible_host=192.168.1.211
k8s-worker-2 ansible_host=192.168.1.212

[k8s_cluster:children]
control_plane
workers

[k8s_cluster:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=~/.ssh/id_ed25519
ansible_python_interpreter=/usr/bin/python3
pod_network_cidr=10.244.0.0/16
k8s_version=1.35

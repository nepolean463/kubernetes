[control_plane]
k8s-cp-1 ansible_host=192.168.1.210 internal_ip=10.240.0.10

[workers]
k8s-worker-1 ansible_host=192.168.1.211 internal_ip=10.240.0.11
k8s-worker-2 ansible_host=192.168.1.212 internal_ip=10.240.0.12

[storage]
k8s-storage-1 ansible_host=192.168.1.215 internal_ip=10.240.0.15

[k8s_cluster:children]
control_plane
workers
storage

[k8s_cluster:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=~/.ssh/id_ed25519
ansible_python_interpreter=/usr/bin/python3
pod_network_cidr=10.244.0.0/16
k8s_version=1.35
